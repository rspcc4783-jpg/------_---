# ============================================================
# 周边民主评议管理系统 - 环境变量示例
# 用法：复制本文件为 .env，并填入你自己的真实值
#   cp .env.example .env
# ============================================================

# ===== Supabase 数据库连接（必填）=====
# 在 Supabase 后台 Project Settings → API 页面获取
# 注意：本项目数据层直接使用 Supabase PostgreSQL，不是 Prisma/SQLite
SUPABASE_URL="https://your-project-ref.supabase.co"

# anon key（公开密钥，前端可用；实际读写受 Supabase 行级安全 RLS 控制）
SUPABASE_ANON_KEY="your-anon-key"

# service_role key（最高权限密钥，仅服务端使用！切勿泄露到前端或提交到仓库）
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ===== JWT 登录签名密钥（必填，请改为随机长字符串）=====
# 生成方式：  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-string"

# ===== 应用名称（可选）=====
NEXT_PUBLIC_APP_NAME="周边民主评议管理系统"
